extends layout.pug

block content
    .w3-container.main-container
      .w3-card-4
        header.w3-container.w3-teal
          h2= titulo
        
        .w3-responsive
          table.w3-table-all.w3-hoverable
            thead
              tr.w3-light-grey
                th ID
                th Nome
                th Username
                th Email
                th Role
                th Ações
            tbody
              each user in users
                tr
                  td= user.id
                  td= user.nome
                  td= user.username
                  td= user.email
                  td
                    span.role-badge.w3-blue-grey= user.role
                  td
                    //- Exemplo de botões para futuras funcionalidades
                    a.w3-button.w3-tiny.w3-round.w3-orange.w3-margin-right(href=`/users/edit/${user.id}`) Editar
                    button.w3-button.w3-tiny.w3-round.w3-red(onclick=`apagarUtilizador("${user.id}")`) Apagar

        footer.w3-container.w3-padding
          a.w3-button.w3-teal.w3-round(href="/users/register") + Novo Utilizador

    script.
      function apagarUtilizador(id) {
            // 1. Confirmação de segurança (UX)
            if (confirm('Tem a certeza que deseja apagar o utilizador com ID ' + id + '?')) {
        
                // 2. Chamada AJAX usando o padrão jQuery
                $.ajax({
                    url: '/users/' + id,
                    method: 'DELETE',
                    success: function(data) {
                        if (data.success) {
                            alert(data.message);
                            // 3. Opção A: Recarregar a página para atualizar a lista
                            location.reload();
                    
                            /* Opção B (Mais "Pro"): Remover apenas a linha da tabela sem refresh
                            $(`tr:contains('${id}')`).fadeOut(); 
                            */
                        } else {
                            alert('Erro: ' + data.message);
                        }
                    },
                    error: function(xhr) {
                        // Tenta obter a mensagem de erro enviada pelo Express
                        const erroMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Erro ao comunicar com o servidor';
                        alert('Erro: ' + erroMsg);
                    }
                });
            }
      }