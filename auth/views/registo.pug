extends layout.pug

block content
    .w3-container.container-registo
        .w3-card-4.w3-white.w3-round-large
            header.w3-container.w3-blue-grey.w3-round-small
                h3 Criar Nova Conta

            form(id="formRegisto").w3-container.w3-padding-16
                .w3-row-section
                    .w3-section
                        label 
                            b Nome Completo
                        input.w3-input.w3-border(type="text" id="nome" required)
                    .w3-section
                        label
                            b Email
                        input.w3-input.w3-border(type="email" id="email" required)

                    .w3-section
                        label
                            b Username
                        input.w3-input.w3-border(type="text" id="username" required)
            
                .w3-row-padding(style="margin:0 -16px;")
                    .w3-half.w3-section
                        label
                            b Password
                        input.w3-input.w3-border(type="password" id="password" required)
                    .w3-half.w3-section
                        label
                            b Confirmar Password
                        input.w3-input.w3-border(type="password" id="conf_password" required)
                
                .w3-panel.w3-light-grey.w3-leftbar.w3-border-blue-grey
                    ul.feedback-pass
                        li(id="comp") ❌ Mínimo 4 caracteres
                        li(id="maius") ❌ Uma letra maiúscula
                        li(id="minus") ❌ Uma letra minúscula
                        li(id="digito") ❌ Um número
                        li(id="match") ❌ As passwords coincidem
                
                button(type="submit").w3-button.w3-block.w3-blue-grey.w3-section.w3-padding.w3-hover-teal Finalizar Registo

    script.
        $(document).ready(function() {
            const API_URL = "http://localhost:3001/users";
            const JSON_SERVER_URL = "http://localhost:3000/users";

            // Verifica se o username já está em uso
            // Esta função devolve uma Promise para podermos esperar pela resposta do servidor
            function verificarDisponibilidadeUsername(username) {
                const $campo = $('#username');
                $('.aviso-user').remove(); // Limpa avisos anteriores

                if (username === "") return Promise.resolve(false)
                else
                    // Retornamos o pedido Ajax para ser usado com .then() ou await
                    return $.ajax({
                            url: `${JSON_SERVER_URL}?username=${username}`,
                            method: "GET"
                        })
                        .then(data => {
                            if (data.length > 0) {
                                $campo.addClass('w3-border-red').removeClass('w3-border-green');
                                $campo.after('<span class="aviso-user w3-text-red w3-small">❌ Username já ocupado.</span>');
                                return false; // Não está disponível
                            } else {
                                $campo.addClass('w3-border-green').removeClass('w3-border-red');
                                $campo.after('<span class="aviso-user w3-text-green w3-small">✅ Username disponível!</span>');
                                return true; // Está disponível
                            }
                        });
            }

            // 1. Verificação ao sair do campo (Blur)
            $('#username').on('blur', function() {
                verificarDisponibilidadeUsername($(this).val().trim());
            });

            // 2. LOGICA DE VALIDAÇÃO DE PASSWORDS (Igual ao exemplo anterior)
            function validarPasswords() {
                const p1 = $('#password').val();
                const p2 = $('#conf_password').val();
                updateStatus(p1.length > 3, $('#comp'));
                updateStatus(/[A-Z]/.test(p1), $('#maius'));
                updateStatus(/[a-z]/.test(p1), $('#minus'));
                updateStatus(/[0-9]/.test(p1), $('#digito'));
                updateStatus(p1 === p2 && p1 !== "", $('#match'));
            }

            function updateStatus(cond, $el) {
                if (cond) $el.addClass('w3-text-green').removeClass('w3-text-red').html($el.html().replace('❌', '✅'));
                else $el.addClass('w3-text-red').removeClass('w3-text-green').html($el.html().replace('✅', '❌'));
            }

            $('#password, #conf_password').on('input', validarPasswords);

            // 3. SUBMISSÃO (POST para o Servidor)
            $('#formRegisto').submit(async function(e) {
                e.preventDefault();
                const username = $('#username').val().trim();
                const disponivel = await verificarDisponibilidadeUsername(username);

                if (!disponivel) 
                    alert("Escolha um username válido e disponível.");
                else{
                    p1 = $('#password').val();
                    p2 = $('#conf_password').val();
                    tudoValido = p1.length > 3 && /[A-Z]/.test(p1) && /[a-z]/.test(p1) && /[0-9]/.test(p1) && p1 === p2;

                    if (tudoValido) {
                        const novoUtilizador = {
                            nome: $('#nome').val(),
                            email: $('#email').val(),
                            username: $('#username').val(),
                            password: p1,
                            role: "utilizador"
                        };
                        // Enviar os dados para o json-server
                        $.ajax({
                            url: API_URL,
                            method: "POST",
                            contentType: "application/json",
                            data: JSON.stringify(novoUtilizador),
                            success: function(response) {
                                alert("Registo concluído com sucesso! ID: " + response.id);
                                window.location.href = "http://localhost:3001/users";
                            },
                            error: function() {
                                alert("Erro ao gravar os dados no servidor.");
                            }
                        });
                    }
                    else
                        alert("A validação das passwords falhou...");
                }
            });
        });
