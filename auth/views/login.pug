extends layout.pug

block content
    .w3-container.container-central
      .w3-card-4.w3-white.w3-round-large
        header.w3-container.w3-teal.w3-round-small
          h4 Login de Utilizador

        form#meuFormulario.w3-container.w3-padding-16
          .w3-section
            label: b Username
            input#username.w3-input.w3-border.w3-light-grey(type="text", required)

          .w3-section
            label: b Password
            input#password.w3-input.w3-border.w3-light-grey(type="password", required)
            
            .w3-panel.w3-pale-red.w3-leftbar.w3-border-red.w3-small
              ul(style="list-style: none; padding: 10px 0;")
                li#comp ❌ Mais de 3 caracteres
                li#maius ❌ Pelo menos uma maiúscula
                li#minus ❌ Pelo menos uma minúscula
                li#digito ❌ Pelo menos um dígito

          button#btnEntrar.w3-button.w3-block.w3-teal.w3-section.w3-padding(type="submit") Entrar

    script.
      const API_URL = "http://localhost:3001/users/login";
      const REDIRECT_URL = "#{redirectTo}";

      $(function() {
          // Validação visual em tempo real (baseada no ficheiro login_jq.html)
          $('#password').on('input', function() {
              const val = $(this).val();
              validar(val.length > 3, $('#comp'));
              validar(/[A-Z]/.test(val), $('#maius'));
              validar(/[a-z]/.test(val), $('#minus'));
              validar(/[0-9]/.test(val), $('#digito'));
          });

          function validar(condicao, $elemento) {
              if (condicao) {
                  $elemento.addClass('w3-text-green').removeClass('w3-text-red');
                  $elemento.text($elemento.text().replace('❌', '✅'));
              } else {
                  $elemento.addClass('w3-text-red').removeClass('w3-text-green');
                  $elemento.text($elemento.text().replace('✅', '❌'));
              }
          }

          // Submissão para o Servidor Express
          $('#meuFormulario').submit(function(e) {
              e.preventDefault();
              
              const username = $('#username').val();
              const password = $('#password').val();
              const $btn = $('#btnEntrar');

              // Bloquear botão para evitar múltiplos cliques
              $btn.prop('disabled', true).append(' <div class="loader"></div>');

              // Chamada AJAX para o servidor Express que consulta o json-server
              $.ajax({
                  url: `${API_URL}`,
                  method: 'POST',
                  contentType: 'application/json',
                  data: JSON.stringify({ username, password }),
                  success: function(res) {
                      alert('Sucesso: ' + res.message + ' ' + res.nome);
                      window.location.href = REDIRECT_URL;
                  },
                  error: function(err) {
                      const msg = err.responseJSON ? err.responseJSON.message : 'Erro na autenticação';
                      alert('Erro: ' + msg);
                  },
                  complete: function() {
                      // Restaurar botão
                      $btn.prop('disabled', false).find('.loader').remove();
                  }
              });
          });
      });