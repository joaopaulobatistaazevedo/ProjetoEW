extends layout.pug

block content
    .w3-container(style="max-width:500px; margin:auto; margin-top:50px;")
      .w3-card-4
        header.w3-container.w3-orange.w3-text-white
          h2 Editar Utilizador
        
        form#formEditar.w3-container.w3-padding-16
          input#userId(type="hidden" value=user.id)
          
          label: b Nome
          input#nome.w3-input.w3-border(type="text" value=user.nome required)
          
          label: b Email
          input#email.w3-input.w3-border(type="email" value=user.email required)
          
          label: b Role
          select#role.w3-select.w3-border
            option(value="utilizador" selected=user.role=='utilizador') Utilizador
            option(value="administrador" selected=user.role=='administrador') Administrador
            option(value="editor" selected=user.role=='editor') Editor

          button.w3-button.w3-orange.w3-margin-top(type="submit") Guardar Alterações
          a.w3-button.w3-light-grey.w3-margin-top.w3-margin-left(href="/users") Cancelar

    script.
      $(function() {
        $('#formEditar').submit(function(e) {
          e.preventDefault();
          const id = $('#userId').val();
          
          const dadosAtualizados = {
            nome: $('#nome').val(),
            email: $('#email').val(),
            role: $('#role').val(),
            // Mantemos o username e password originais (ou poderias adicionar campos para eles)
            username: "#{user.username}",
            password: "#{user.password}"
          };

          $.ajax({
            url: '/users/' + id,
            method: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify(dadosAtualizados),
            success: function(res) {
              alert(res.message);
              window.location.href = '/users';
            },
            error: function() {
              alert('Erro ao atualizar utilizador.');
            }
          });
        });
      });