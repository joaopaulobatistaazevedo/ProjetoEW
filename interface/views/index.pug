extends layout

block content
  if user
    // Hero (autenticado)
    section.hero
      .hero-content
        h1
          i.fas.fa-welcome
          span  Bem-vindo de volta!
        p Olá #{user.nome}, vamos explorar e compartilhar conhecimento educativo.
    
    // Acesso rapido
    .container.py-6
      .row
        .col-12.mb-6
          h2
            i.fas.fa-chart-line(style='color: var(--primary); margin-right: 0.5rem;')
            span Acesso Rápido
        
        .col-3
          .card.stat-card
            span.stat-number
              i.fas.fa-book(style='color: var(--secondary);')
            span.stat-label Explorar Recursos
            a.btn.btn-outline.mt-4(href="/recursos") Ir para Recursos
        
        .col-3
          .card.stat-card
            span.stat-number
              i.fas.fa-users(style='color: var(--primary);')
            span.stat-label Comunidade
            a.btn.btn-outline.mt-4(href="/utilizadores") Ver Utilizadores

  else
    // Hero (visitante)
    section.hero
      .hero-content
        h1
          i.fas.fa-graduation-cap
          span  Plataforma de Recursos Educativos
        p Explore recursos educativos e participe da comunidade.
        .mt-4(style='display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;')
          a.btn.btn-primary(href="/auth/login")
            i.fas.fa-sign-in-alt
            span Entrar
          a.btn.btn-secondary(href="/auth/registo")
            i.fas.fa-user-plus
            span Registar-se

  // Mostrar noticias recentes na homepage (sidebar)
  if noticias && noticias.length
    .container.py-6
      h2
        i.fas.fa-newspaper(style='color: var(--primary); margin-right: 0.5rem;')
        span Últimas Notícias
      .noticias-grid
        each n in noticias
          - const badgeClass = n.tipo === 'novo_recurso' ? 'badge-noticia badge-noticia-novo' : n.tipo === 'trending' ? 'badge-noticia badge-noticia-trending' : n.tipo === 'comentarios' ? 'badge-noticia badge-noticia-comentarios' : n.tipo === 'tipo_destaque' ? 'badge-noticia badge-noticia-tipo' : n.tipo === 'stats' ? 'badge-noticia badge-noticia-stats' : 'badge-noticia badge-noticia-milestone';
          .card.noticia-card
            .card-body
              .noticia-header
                span(class=badgeClass)
                  case n.tipo
                    when 'novo_recurso'
                      i.fas.fa-star
                    when 'trending'
                      i.fas.fa-fire
                    when 'comentarios'
                      i.fas.fa-comments
                    when 'tipo_destaque'
                      i.fas.fa-tag
                    when 'stats'
                      i.fas.fa-chart-pie
                    default
                      i.fas.fa-trophy
                .noticia-meta
                  h4= n.titulo
                  small.text-muted= n.dataCriacao ? new Date(n.dataCriacao).toLocaleString('pt-PT') : 'Data indisponível'
              p.noticia-conteudo= n.conteudo
              if n.link
                a.btn.btn-outline.btn-sm(href=n.link)
                  i.fas.fa-eye
                  span Ver recurso

  if top3 && top3.length
    .container.py-6
      h2
        i.fas.fa-trophy(style='color: var(--warning); margin-right: 0.5rem;')
        span Top 3 Recursos
      .row
        each recurso, idx in top3
          .col-4
            .card.resource-card
              .card-body
                span.resource-badge.badge-public
                  i.fas.fa-trophy(style='margin-right: 0.25rem;')
                  | ##{idx + 1}
                h3.resource-title= recurso.titulo
                if recurso.subtitulo
                  p.resource-subtitle= recurso.subtitulo
                .resource-meta
                  span
                    i.fas.fa-star(style='color: var(--warning);')
                    |  #{recurso.mediaEstrelas ? recurso.mediaEstrelas.toFixed(1) : '0.0'}
                  if recurso.autor
                    span
                      i.fas.fa-user
                      |  #{recurso.autor.nome}
              .card-footer
                a.btn.btn-primary.btn-sm(href='/recursos/' + recurso._id)
                  i.fas.fa-eye
                  span Ver
  
  style.
    .noticias-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }
    .noticia-card {
      border-left: 4px solid var(--primary);
      height: 100%;
    }
    .noticia-header {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .badge-noticia {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      color: #fff;
      flex-shrink: 0;
    }
    .badge-noticia-novo { background: var(--primary); }
    .badge-noticia-trending { background: #ef4444; }
    .badge-noticia-comentarios { background: #0ea5e9; }
    .badge-noticia-tipo { background: #8b5cf6; }
    .badge-noticia-stats { background: #10b981; }
    .badge-noticia-milestone { background: #f59e0b; }
    .noticia-meta h4 {
      margin-bottom: 0.25rem;
    }
    .noticia-conteudo {
      color: #475569;
      margin-bottom: 1rem;
    }
