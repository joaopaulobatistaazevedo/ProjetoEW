extends layout

block content
  .w3-container.w3-padding-64
    .w3-display-container(style="min-height: 600px;")
      .w3-display-middle.w3-center(style="width: 90%; max-width: 900px;")
        .w3-card-4.w3-white.w3-round-large.w3-animate-top
          header.w3-container.w3-blue
            h1.w3-margin-top
              | 📚 Recursos Educativos
          
          .w3-container.w3-padding-24
            if user
              p.w3-text-dark
                | Bem-vindo, 
                strong= user.nome
              
              .w3-row.w3-margin-top
                .w3-col.s6.w3-padding
                  a.w3-button.w3-blue.w3-block(href="/recursos") Ver Recursos
                .w3-col.s6.w3-padding
                  a.w3-button.w3-green.w3-block(href="/utilizadores") Utilizadores
              
              .w3-row.w3-margin-top
                .w3-col.s6.w3-padding
                  a.w3-button.w3-orange.w3-block(href="/posts") Posts
                .w3-col.s6.w3-padding
                  a.w3-button.w3-red.w3-block(href="/auth/logout") Sair
            else
              p.w3-text-grey
                | Aceda à plataforma de recursos educativos
              
              a.w3-button.w3-blue.w3-block.w3-padding-16(href="/auth/login") Login
