extends layout

block content
  .w3-container.w3-padding-64
    .w3-display-container(style="min-height: 400px;")
      .w3-display-middle.w3-center(style="width: 80%; max-width: 600px;")
        .w3-card-4.w3-white.w3-round-large.w3-animate-top
          header.w3-container.w3-red.w3-round-small
            h2.w3-margin-top
              | Algo correu mal!
          
          .w3-container.w3-padding-24
            h3.w3-text-grey Erro detetado no sistema
            
            .w3-panel.w3-pale-red.w3-leftbar.w3-border-red.w3-padding-16.w3-left-align
              p.w3-text-dark
                strong= `${error.status || 500}:`
                | &nbsp;
                span= message

            if error.stack
              .w3-panel.w3-light-grey.w3-padding-16.w3-left-align(style="font-family: monospace; font-size: 12px; white-space: pre-wrap; overflow-x: auto;")= error.stack
            
            .w3-row.w3-margin-top
              .w3-col.s12
                a.w3-button.w3-light-grey.w3-block(href="/") Voltar à página inicial
