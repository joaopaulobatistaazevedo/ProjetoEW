extends ../layout

block content
  .container.container-md.py-8
    .row
      .col-12
        .card
          .card-header
            h2
              i.fas.fa-sign-in-alt(style='margin-right: 0.75rem;')
              span Entrar na Plataforma
          
          .card-body
            if erro
              .alert.alert-danger
                i.fas.fa-exclamation-circle(style='margin-right: 0.5rem;')
                strong= erro
            
            // Formulario de login
            form(method='POST', action='/auth/login')
              .form-group
                label(for='username')
                  i.fas.fa-user(style='margin-right: 0.5rem;')
                  span Nome de Utilizador
                input#username.form-control(type='text', name='username', placeholder='Seu nome de utilizador...', required=true)
              
              .form-group
                label(for='password')
                  i.fas.fa-lock(style='margin-right: 0.5rem;')
                  span Palavra-passe
                input#password.form-control(type='password', name='password', placeholder='Sua palavra-passe...', required=true)
              
              button.btn.btn-primary.btn-block(type='submit')
                i.fas.fa-sign-in-alt
                span Entrar
            
            hr(style='margin: 2rem 0; border: none; border-top: 1px solid var(--light-gray);')
            
            // Link para registo
            .text-center(style='text-align: center;')
              p.text-muted(style='color: var(--gray); margin-bottom: 1rem;')
                | Ainda não tem conta?
              a.btn.btn-secondary.btn-block(href='/auth/registo')
                i.fas.fa-user-plus
                span Criar Conta Agora
