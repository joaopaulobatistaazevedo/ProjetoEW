extends ../layout

block content
  .w3-container.w3-padding-32
    .w3-card-4.w3-white(style='max-width: 640px; margin: 0 auto;')
      .w3-container.w3-green
        h2 Registo
      .w3-container.w3-padding-16
        if erro
          .w3-panel.w3-pale-red.w3-border.w3-border-red
            p= erro
        form(method='POST', action='/auth/registo')
          p
            label(for='username') Username
            input#username.w3-input.w3-border(type='text', name='username', required=true)
          p
            label(for='nome') Nome
            input#nome.w3-input.w3-border(type='text', name='nome', required=true)
          p
            label(for='email') Email
            input#email.w3-input.w3-border(type='email', name='email', required=true)
          p
            label(for='password') Password
            input#password.w3-input.w3-border(type='password', name='password', required=true)
          p
            label(for='role') Perfil
            select#role.w3-select.w3-border(name='role')
              option(value='consumidor' selected=true) consumidor
              option(value='produtor') produtor
              option(value='admin') admin
          p
            label(for='filiacao') Filiacao
            input#filiacao.w3-input.w3-border(type='text', name='filiacao')
          p
            button.w3-button.w3-green.w3-block(type='submit') Criar conta
        p.w3-small
          a(href='/auth/login') Voltar ao login
