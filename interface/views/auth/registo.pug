extends ../layout

block content
  .container.container-md.py-8
    .row
      .col-12
        .card
          .card-header
            h2
              i.fas.fa-user-plus(style='margin-right: 0.75rem;')
              span Criar Conta
          
          .card-body
            if erro
              .alert.alert-danger
                i.fas.fa-exclamation-circle(style='margin-right: 0.5rem;')
                strong= erro
            
            form(method='POST', action='/auth/registo')
              .form-group
                label(for='username')
                  i.fas.fa-at(style='margin-right: 0.5rem;')
                  span Nome de Utilizador
                input#username.form-control(type='text', name='username', placeholder='Escolha um nome de utilizador...', required=true)
              
              .form-group
                label(for='nome')
                  i.fas.fa-id-card(style='margin-right: 0.5rem;')
                  span Nome Completo
                input#nome.form-control(type='text', name='nome', placeholder='Seu nome completo...', required=true)
              
              .form-group
                label(for='email')
                  i.fas.fa-envelope(style='margin-right: 0.5rem;')
                  span Email
                input#email.form-control(type='email', name='email', placeholder='seu.email@exemplo.com', required=true)
              
              .form-group
                label(for='password')
                  i.fas.fa-lock(style='margin-right: 0.5rem;')
                  span Palavra-passe
                input#password.form-control(type='password', name='password', placeholder='Escolha uma palavra-passe forte...', required=true)
              
              .form-group
                label(for='filiacao')
                  i.fas.fa-building(style='margin-right: 0.5rem;')
                  span Instituição (opcional)
                input#filiacao.form-control(type='text', name='filiacao', placeholder='Sua escola, universidade ou instituição...')
              
              button.btn.btn-secondary.btn-block(type='submit')
                i.fas.fa-check-circle
                span Criar Conta
            
            hr(style='margin: 2rem 0; border: none; border-top: 1px solid var(--light-gray);')
            
            .text-center(style='text-align: center;')
              p.text-muted(style='color: var(--gray); margin-bottom: 1rem;')
                | Já tem conta?
              a.btn.btn-primary.btn-block(href='/auth/login')
                i.fas.fa-sign-in-alt
                span Voltar ao Login
