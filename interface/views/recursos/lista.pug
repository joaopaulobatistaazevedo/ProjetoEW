extends ../layout

block content
  .container.py-6
    // Header + botao de novo recurso
    .row.mb-6
      .col-9
        h1
          i.fas.fa-book(style='margin-right: 0.75rem; color: var(--primary);')
          span Recursos Educativos
      .col-3
        if user
          a.btn.btn-primary.btn-block(href='/recursos/novo')
            i.fas.fa-plus
            span Submeter Recurso
    
    // Alerta de erro (se houver)
    if erro
      .alert.alert-danger
        i.fas.fa-exclamation-triangle(style='margin-right: 0.5rem;')
        strong= erro
    
    // Filtros
    .card.mb-6
      .card-header
        i.fas.fa-filter
        span  Filtrar Recursos
      .card-body
        - const meusRecursosAtivo = user && filtros && String(filtros.autor || '') === String(user.sub || '');
        form.row(method='GET', action='/recursos')
          .col-4
            .form-group
              label(for='q') Pesquisa livre
              input#q.form-control(type='text', name='q', placeholder='Titulo, descricao, hashtags...', value=(filtros && filtros.q) || '')
          .col-4
            .form-group
              label(for='tipo') Tipo
              select#tipo.form-control(name='tipo')
                option(value='') Todos os tipos
                each tipo in tiposRecurso
                  option(value=tipo.slug selected=((filtros && filtros.tipo) === tipo.slug))= tipo.nome
          .col-4
            .form-group
              label(for='hashtag') Hashtag
              input#hashtag.form-control(type='text', name='hashtag', placeholder='Ex: matematica', value=(filtros && filtros.hashtag) || '')
          .col-3
            .form-group
              label(for='ano') Ano
              input#ano.form-control(type='number', name='ano', placeholder='2026', value=(filtros && filtros.ano) || '')
          .col-3
            .form-group
              label(for='sort') Ordenar por
              select#sort.form-control(name='sort')
                option(value='dataRegisto' selected=((filtros && filtros.sort) === 'dataRegisto' || !(filtros && filtros.sort))) Mais recentes
                option(value='mediaEstrelas' selected=((filtros && filtros.sort) === 'mediaEstrelas')) Melhor classificados
                option(value='relevancia' selected=((filtros && filtros.sort) === 'relevancia')) Relevancia
          .col-3
            .form-group
              label(for='order') Ordem
              select#order.form-control(name='order')
                option(value='desc' selected=((filtros && filtros.order) === 'desc' || !(filtros && filtros.order))) Descendente
                option(value='asc' selected=((filtros && filtros.order) === 'asc')) Ascendente
          if user
            .col-12
              .form-group.filters-inline-row
                label.checkbox-filter(for='meus-recursos')
                  input#meus-recursos.checkbox-filter-input(type='checkbox', name='autor', value=(user.sub || '') checked=((filtros && filtros.autor) === (user.sub || '')))
                  span Mostrar apenas os meus recursos
                .visibility-inline#visibilidade-filter(style=meusRecursosAtivo ? '' : 'display:none;')
                  label(for='visibilidade') Visibilidade
                  select#visibilidade.form-control(name='visibilidade' disabled=!meusRecursosAtivo)
                    option(value='') Todas
                    option(value='publico' selected=((filtros && filtros.visibilidade) === 'publico')) Publico
                    option(value='privado' selected=((filtros && filtros.visibilidade) === 'privado')) Privado
          .col-12
            .filters-actions
              button.btn.btn-primary(type='submit')
                i.fas.fa-search
                span Filtrar
              a.btn.btn-outline(href='/recursos')
                i.fas.fa-rotate-left
                span Limpar Filtros
        if user
          script.
            document.addEventListener('DOMContentLoaded', function () {
              var meusRecursos = document.getElementById('meus-recursos');
              var visibilidadeFiltro = document.getElementById('visibilidade-filter');
              var visibilidade = document.getElementById('visibilidade');
              if (!meusRecursos || !visibilidadeFiltro || !visibilidade) return;

              function atualizarVisibilidade() {
                var ativo = meusRecursos.checked;
                visibilidadeFiltro.style.display = ativo ? '' : 'none';
                visibilidade.disabled = !ativo;
                if (!ativo) visibilidade.value = '';
              }

              meusRecursos.addEventListener('change', atualizarVisibilidade);
              atualizarVisibilidade();
            });
    
    // Lista de recursos
    if recursos && recursos.length
      .row
        each recurso in recursos
          .col-6
            .card.resource-card
              if recurso.visibilidade === 'publico'
                span.resource-badge.badge-public
                  i.fas.fa-globe(style='margin-right: 0.25rem;')
                  | Público
              else
                span.resource-badge.badge-private
                  i.fas.fa-lock(style='margin-right: 0.25rem;')
                  | Privado
              
              .card-body
                h3.resource-title= recurso.titulo
                if recurso.subtitulo
                  p.resource-subtitle= recurso.subtitulo
                
                .resource-meta
                  span
                    i.fas.fa-tag
                    | #{recurso.tipoNome || recurso.tipo}
                  if recurso.autor
                    span
                      i.fas.fa-user
                      | #{recurso.autor.nome}
                
                p(style='color: #64748b; font-size: 0.9rem; display:flex; align-items:center; gap:0.5rem;')
                  // Mostrar estrelas com base na média (arredondada)
                  - var filled = Math.round(recurso.mediaEstrelas || 0);
                  .stars-mini
                    - for (var i = 1; i <= 5; i++)
                      if i <= filled
                        i.fas.fa-star(style='color: var(--warning); margin-right: 0.125rem;')
                      else
                        i.far.fa-star(style='color: var(--light-gray); margin-right: 0.125rem;')
                  span(style='margin-left:0.25rem; font-weight:600;') #{recurso.mediaEstrelas ? recurso.mediaEstrelas.toFixed(1) : 'N/A'}
                  span.text-muted(style='margin-left:0.25rem; font-size:0.85rem;') (#{recurso.ratings ? recurso.ratings.length : 0} votos)
              
              .card-footer
                a.btn.btn-primary.btn-sm(href='/recursos/' + recurso._id)
                  i.fas.fa-eye
                  span Ver
                - const podeExportar = user && (user.role === 'admin' || recurso.visibilidade === 'publico' || (user.role === 'produtor' && recurso.autor && String(user.sub) === String(recurso.autor._id)));
                if podeExportar
                  a.btn.btn-secondary.btn-sm(href='/recursos/' + recurso._id + '/exportar-dip', title='Exportar DIP')
                    i.fas.fa-file-export
                    span Exportar DIP

                - const podeEditar = user && (user.role === 'admin' || (user.role === 'produtor' && recurso.autor && String(user.sub) === String(recurso.autor._id)));
                if podeEditar
                  a.btn.btn-primary.btn-sm(href='/recursos/' + recurso._id + '/editar')
                    i.fas.fa-edit
                    span Editar
                  form(method='POST', action='/recursos/' + recurso._id + '/apagar', style='display:inline', onsubmit='return confirm("Tem a certeza?");')
                    button.btn.btn-danger.btn-sm(type='submit')
                      i.fas.fa-trash-alt
                      span Apagar
    else
        .empty-state
          i.fas.fa-inbox.empty-icon
          h3.empty-title Nenhum recurso encontrado
          p.empty-text Nao ha recursos disponiveis com estes filtros. Tente ajustar a pesquisa.
