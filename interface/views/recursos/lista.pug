extends ../layout

block content
  .container.py-6
    // Header com Título e Botão de Novo Recurso
    .row.mb-6
      .col-9
        h1
          i.fas.fa-book(style='margin-right: 0.75rem; color: var(--primary);')
          span Recursos Educativos
      .col-3
        if user
          a.btn.btn-primary.btn-block(href='/recursos/novo')
            i.fas.fa-plus
            span Novo Recurso
    
    // Alerta de Erro (se houver)
    if erro
      .alert.alert-danger
        i.fas.fa-exclamation-triangle(style='margin-right: 0.5rem;')
        strong= erro
    
    // Filtros
    .card.mb-6
      .card-header
        i.fas.fa-filter
        span  Filtrar Recursos
      .card-body
        form.row(method='GET', action='/recursos')
          .col-3
            input.form-control(type='text', name='tipo', placeholder='Tipo de recurso...', value=(filtros && filtros.tipo) || '')
          .col-3
            input.form-control(type='text', name='hashtag', placeholder='Hashtag...', value=(filtros && filtros.hashtag) || '')
          .col-3
            input.form-control(type='text', name='ano', placeholder='Ano...', value=(filtros && filtros.ano) || '')
          .col-3
            button.btn.btn-primary.btn-block(type='submit')
              i.fas.fa-search
              span Filtrar
    
    // Recursos
    if recursos && recursos.length
      .row
        each recurso in recursos
          .col-6
            .card.resource-card
              if recurso.visibilidade === 'publico'
                span.resource-badge.badge-public
                  i.fas.fa-globe(style='margin-right: 0.25rem;')
                  | Público
              else
                span.resource-badge.badge-private
                  i.fas.fa-lock(style='margin-right: 0.25rem;')
                  | Privado
              
              .card-body
                h3.resource-title= recurso.titulo
                if recurso.subtitulo
                  p.resource-subtitle= recurso.subtitulo
                
                .resource-meta
                  span
                    i.fas.fa-tag
                    | #{recurso.tipo}
                  if recurso.autor
                    span
                      i.fas.fa-user
                      | #{recurso.autor.nome}
                
                p(style='color: #64748b; font-size: 0.9rem;')
                  i.fas.fa-star(style='color: var(--warning); margin-right: 0.25rem;')
                  span Média: 
                  strong #{recurso.mediaEstrelas || 'N/A'}
              
              .card-footer
                a.btn.btn-primary.btn-sm(href='/recursos/' + recurso._id)
                  i.fas.fa-eye
                  span Ver
                
                if user && (user.role === 'admin' || (user.role === 'produtor' && user.sub === recurso.autor._id))
                  a.btn.btn-primary.btn-sm(href='/recursos/' + recurso._id + '/editar')
                    i.fas.fa-edit
                    span Editar
                  form(method='POST', action='/recursos/' + recurso._id + '/apagar', style='display:inline', onsubmit='return confirm("Tem a certeza?");')
                    button.btn.btn-danger.btn-sm(type='submit')
                      i.fas.fa-trash-alt
                      span Apagar
    else
      .empty-state
        i.fas.fa-inbox.empty-icon
        h3.empty-title Nenhum recurso encontrado
        p.empty-text Não há recursos disponíveis no momento. Tente alterar seus filtros.
