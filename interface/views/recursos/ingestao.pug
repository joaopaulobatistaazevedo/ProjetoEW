extends ../layout

block content
  .container.py-6
    .row.mb-6
      .col-8
        h1
          i.fas.fa-box-open(style='margin-right: 0.75rem; color: var(--primary);')
          span Submeter SIP
        p.text-muted Envie um pacote ZIP com manifesto e ficheiros associados.
      .col-4.text-right
        a.btn.btn-outline(href='/recursos/aips')
          i.fas.fa-archive
          span Ver AIPs

    if erro
      .alert.alert-danger
        strong= erro
        if detalhes
          pre(style='white-space: pre-wrap; margin-top: 0.75rem;')= detalhes

    if sucesso
      .alert.alert-success
        strong= sucesso

    .card
      .card-body
        form(method='POST', action='/recursos/ingestao-sip', enctype='multipart/form-data')
          .form-group
            label(for='file')
              i.fas.fa-file-archive(style='margin-right: 0.5rem;')
              | Ficheiro ZIP
            input#file.form-control(type='file', name='file', accept='.zip', required=true, style='padding: 0.5rem;')
            small.text-muted O ficheiro deve seguir a estrutura SIP definida pelo manifesto.

          .form-group
            label(for='descricao')
              i.fas.fa-align-left(style='margin-right: 0.5rem;')
              | Observações (opcional)
            textarea#descricao.form-control(name='descricao', rows='4', placeholder='Notas adicionais para a submissão...')

          .form-actions
            button.btn.btn-primary(type='submit')
              i.fas.fa-upload
              span Submeter SIP
            a.btn.btn-outline(href='/recursos')
              i.fas.fa-arrow-left
              span Voltar

    .card.mt-4
      .card-body
        h3(style='margin-top: 0;') O que é verificado
        ul
          li Estrutura do pacote ZIP
          li Manifesto e ficheiros declarados
          li Metadados obrigatórios
          li Consistência e segurança
