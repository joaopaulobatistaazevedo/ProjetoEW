extends ../layout

block content
  .container.py-6
    .row.mb-6
      .col-8
        h1
          i.fas.fa-inbox(style='margin-right: 0.75rem; color: var(--primary);')
          span Submeter Recurso
        p.text-muted Escolha uma das opções abaixo para submeter um novo recurso educativo.


    if erro
      .alert.alert-danger
        strong= erro
        if detalhes
          pre(style='white-space: pre-wrap; margin-top: 0.75rem;')= detalhes

    if sucesso
      .alert.alert-success
        strong= sucesso

    .row.mb-6
      .col-6
        .card(style='height: 100%;')
          .card-header
            i.fas.fa-edit
            span  Opção 1: Formulário Assistido
          .card-body(style='display: flex; flex-direction: column;')
            p Preencha um formulário simples e carregue múltiplos ficheiros. Ideal para submissões rápidas e diretas.
            ul(style='margin: 1.5rem 0; flex: 1; list-style: none; padding: 0;')
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Preenchimento de metadados em formulário
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Upload de múltiplos ficheiros
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Processamento automático de SIP
            a.btn.btn-primary(href='/recursos/ingestao-form' style='align-self: flex-start; margin-top: auto;')
              i.fas.fa-arrow-right
              span Usar Formulário

      .col-6
        .card(style='height: 100%;')
          .card-header
            i.fas.fa-file-archive
            span  Opção 2: SIP ZIP
          .card-body(style='display: flex; flex-direction: column;')
            p Carregue um pacote SIP já estruturado com manifesto e ficheiros. Ideal para migrações em lote.
            ul(style='margin: 1.5rem 0; flex: 1; list-style: none; padding: 0;')
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Pacote ZIP estruturado
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Manifesto JSON incluído
              li(style='margin-bottom: 0.75rem;')
                i.fas.fa-check(style='color: var(--success); margin-right: 0.5rem;')
                | Validação completa
            a.btn.btn-primary(href='/recursos/form' style='align-self: flex-start; margin-top: auto;')
              i.fas.fa-arrow-right
              span Usar SIP ZIP