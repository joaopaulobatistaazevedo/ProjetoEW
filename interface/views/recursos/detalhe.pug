extends ../layout

block content
  .container.py-6
    // Breadcrumb
    .mb-4
      a(href='/recursos', style='color: var(--gray);')
        i.fas.fa-arrow-left(style='margin-right: 0.25rem;')
        span Voltar a Recursos

    // Detalhe do recurso
    .row.mb-6
      .col-12
        .card
          .card-header
            h1= recurso.titulo
            if recurso.subtitulo
              p.resource-subtitle= recurso.subtitulo
          
          .card-body
            if recurso.visibilidade === 'publico'
              span.resource-badge.badge-public
                i.fas.fa-globe(style='margin-right: 0.25rem;')
                | Público
            else
              span.resource-badge.badge-private
                i.fas.fa-lock(style='margin-right: 0.25rem;')
                | Privado
            
            .resource-meta
              span
                i.fas.fa-tag
                strong= recurso.tipoNome || recurso.tipo
              if recurso.autor
                span
                  i.fas.fa-user
                strong= recurso.autor.nome
              span
                i.fas.fa-star(style='color: var(--warning);')
                strong Média: #{recurso.mediaEstrelas || '0'}

            // Avaliação por estrelas (utilizador autenticado)
            if user
              .mt-3
                form(method='POST', action='/recursos/' + recurso._id + '/rate', id='rating-form')
                  input(type='hidden', name='estrelas', id='estrelas-input', value=(currentUserRating || ''))
                  .rating-actions
                    - var currentUserRating = 0
                    if recurso.ratings
                      - for (var r of recurso.ratings)
                        if user && r.utilizador && (r.utilizador._id ? String(r.utilizador._id) === String(user.sub) : String(r.utilizador) === String(user.sub))
                          - currentUserRating = r.estrelas

                    .stars(style='margin-bottom:0.5rem;')
                      - for (var i = 1; i <= 5; i++)
                        if i <= (currentUserRating || Math.round(recurso.mediaEstrelas || 0))
                          button(type='button', class='star-btn btn-star', data-value=i, title='Avaliar ' + i + ' estrelas', style='background:none; border:none; padding:0; margin-right:0.25rem;')
                            i.fas.fa-star(style='color: var(--warning);')
                        else
                          button(type='button', class='star-btn btn-star', data-value=i, title='Avaliar ' + i + ' estrelas', style='background:none; border:none; padding:0; margin-right:0.25rem;')
                            i.far.fa-star(style='color: var(--light-gray);')

                    button.btn.btn-sm.btn-primary(type='submit')
                      i.fas.fa-star
                      |  Avaliar

                script.
                  document.addEventListener('DOMContentLoaded', function(){
                    var stars = Array.from(document.querySelectorAll('.star-btn'));
                    var input = document.getElementById('estrelas-input');
                    if(!stars.length || !input) return;
                    function colorize(active){
                      stars.forEach(function(s, idx){
                        var icon = s.querySelector('i');
                        if(idx < active){ icon.classList.remove('far'); icon.classList.add('fas'); icon.style.color = 'var(--warning)'; }
                        else { icon.classList.remove('fas'); icon.classList.add('far'); icon.style.color = 'var(--light-gray)'; }
                      });
                    }
                    var inicial = parseInt(input.value,10) || 0;
                    if(inicial) colorize(inicial);
                    stars.forEach(function(s, idx){
                      s.addEventListener('click', function(e){
                        var v = parseInt(this.dataset.value,10);
                        input.value = v;
                        colorize(v);
                      });
                    });
                  });
            
            hr(style='margin: 1.5rem 0; border: none; border-top: 1px solid var(--light-gray);')
            
            if recurso.descricao
              h3 Descrição
              p!= recurso.descricao

            if recurso.ficheirosList && recurso.ficheirosList.length > 0
              .card(style='margin-top: 1.5rem; border: 1px solid var(--light-gray);')
                .card-body
                  h3(style='margin-top: 0;') Ficheiros associados (#{recurso.ficheirosList.length})
                  
                  .list-group
                    - for (var i = 0; i < recurso.ficheirosList.length; i++)
                      - var f = recurso.ficheirosList[i];
                      .list-group-item(style='padding: 1rem; border-bottom: 1px solid var(--light-gray);')
                        .row
                          .col-12
                            p(style='margin-bottom: 0.5rem;')
                              strong= f.nome
                            .resource-meta(style='margin-bottom: 0.75rem;')
                              span
                                i.fas.fa-file
                                |  Tamanho: #{(f.tamanho / 1024).toFixed(2)} KB
                              span
                                i.fas.fa-calendar
                                |  Adicionado: #{new Date(f.dataAdicionado).toLocaleDateString('pt-PT')}
                              span
                                i.fas.fa-fingerprint
                                |  Versão AIP: #{f.versaoAIP}
                            
                            // Preview do ficheiro
                            - var ext = f.nome ? f.nome.split('.').pop().toLowerCase() : '';
                            - var isImagem = ['jpg','jpeg','png','gif','webp','svg'].includes(ext);
                            - var isPdf = ext === 'pdf';
                            - var isVideo = ['mp4','webm','ogg'].includes(ext);
                            - var isAudio = ['mp3','wav','ogg','m4a'].includes(ext);
                            - var isTexto = ['txt','md','csv','json','xml','html','py'].includes(ext);

                            if isImagem
                              img(src='/recursos/' + recurso._id + '/ficheiro/' + i, alt=f.nome, style='max-width: 100%; max-height: 620px; border-radius: 0.25rem; border: 1px solid var(--light-gray);')
                            else if isPdf
                              iframe(src='/recursos/' + recurso._id + '/ficheiro/' + i, style='width: 100%; height: 760px; border: 1px solid var(--light-gray); border-radius: 0.25rem; overflow: auto;')
                            else if isVideo
                              video(controls, style='width: 100%; border-radius: 0.25rem;')
                                source(src='/recursos/' + recurso._id + '/ficheiro/' + i, type='video/' + ext)
                                | O seu browser não suporta a reprodução de vídeo.
                            else if isAudio
                              audio(controls, style='width: 100%; margin-top: 0.25rem;')
                                source(src='/recursos/' + recurso._id + '/ficheiro/' + i, type='audio/' + ext)
                                | O seu browser não suporta a reprodução de áudio.
                            else if isTexto
                              iframe(src='/recursos/' + recurso._id + '/ficheiro/' + i + '?preview=texto', style='width: 100%; height: 620px; border: 1px solid var(--light-gray); border-radius: 0.25rem; background: #fff; color: #0f172a;')
                            else
                              small.text-muted
                                i.fas.fa-eye-slash(style='margin-right: 0.25rem;')
                                | Pré-visualização não disponível para este tipo de ficheiro.

                            div(style='margin-top: 0.75rem; text-align: right;')
                              a.btn.btn-sm.btn-outline-primary(href=f.downloadUrl, title='Descarregar este ficheiro')
                                i.fas.fa-download
                                |  Descarregar
            - const podeEditar = user && (user.role === 'admin' || (user.role === 'produtor' && recurso.autor && String(user.sub) === String(recurso.autor._id)));
            - const podeExportar = user && (user.role === 'admin' || recurso.visibilidade === 'publico' || (user.role === 'produtor' && recurso.autor && String(user.sub) === String(recurso.autor._id)));

            if podeEditar
              .card-footer
                a.btn.btn-primary(href='/recursos/' + recurso._id + '/editar')
                  i.fas.fa-edit
                  span  Editar Recurso
                form(method='POST', action='/recursos/' + recurso._id + '/apagar', style='display:inline', onsubmit='return confirm("Tem a certeza? Esta ação não pode ser desfeita.");')
                  button.btn.btn-danger(type='submit')
                    i.fas.fa-trash-alt
                    span  Apagar Recurso
    .row.mb-6
      .col-12
        .card
          .card-header
            i.fas.fa-info-circle
            span  Informações
          .card-body
            .row
              if recurso.tipo
                .col-3
                  strong Tipo:
                  p= recurso.tipoNome || recurso.tipo
              
              if recurso.visibilidade
                .col-3
                  strong Visibilidade:
                  p
                    if recurso.visibilidade === 'publico'
                      i.fas.fa-globe(style='color: var(--primary); margin-right: 0.25rem;')
                      | Público
                    else
                      i.fas.fa-lock(style='color: var(--warning); margin-right: 0.25rem;')
                      | Privado
              
              if recurso.autor
                .col-3
                  strong Autor:
                  p= recurso.autor.nome
              
              if recurso.criatedAt
                .col-3
                  strong Criado em:
                  p= new Date(recurso.criatedAt).toLocaleDateString('pt-PT')

    .row.mb-6
      .col-12
        .card
          .card-header
            i.fas.fa-download
            span  Download do Recurso
          .card-body
            p.text-muted(style='margin-bottom: 1.25rem;')
              | Descarregue o recurso completo num único pacote ZIP, incluindo todos os ficheiros e o respetivo manifesto. O pacote está pronto para reimportação no sistema caso seja necessário.
            if podeExportar
              a.btn.btn-primary(href='/recursos/' + recurso._id + '/exportar-dip')
                i.fas.fa-download
                span  Descarregar Pacote

    // Posts e comentarios
    .row
      .col-12
        if user
          .card.mb-6
            .card-header
              i.fas.fa-pen
              span  Publicar Discussão
            
            form(method='POST', action='/posts')
              input(type='hidden', name='recurso', value=recurso._id)
              
              .card-body
                .form-group
                  label(for='titulo') Título da Discussão
                  input#titulo.form-control(type='text', name='titulo', placeholder='Título do seu post...', required=true)
                
                .form-group
                  label(for='conteudo') Conteúdo
                  textarea#conteudo.form-control(name='conteudo', placeholder='Partilhe suas ideias e insights...', required=true, rows='5', style='min-height: 140px; resize: vertical;')
              
              .card-footer
                button.btn.btn-primary(type='submit')
                  i.fas.fa-paper-plane
                  span Publicar
        else
          .alert.alert-info.mb-6
            i.fas.fa-sign-in-alt(style='margin-right: 0.5rem;')
            strong
              a(href='/auth/login') Faça login
              |  para publicar discussões e comentários.

        .card
          .card-header
            i.fas.fa-comments
            span  Discussões (#{posts ? posts.length : 0})
          
          if posts && posts.length
            each post in posts
              .card-body(style='border-bottom: 1px solid var(--light-gray); padding: 1.5rem;')
                .row.mb-3
                  .col-9
                    h4= post.titulo || 'Sem titulo'
                  .col-3.text-right
                    small.text-muted
                      i.fas.fa-user-circle(style='margin-right: 0.25rem;')
                      | #{(post.autor && post.autor.nome) || 'Utilizador Desconhecido'}
                
                p(style='color: #475569; line-height: 1.6;')= post.conteudo
                
                if post.comentarios && post.comentarios.length
                  .mt-4
                    .mb-3
                      strong
                        i.fas.fa-comments(style='margin-right: 0.5rem;')
                        | Comentários (#{post.comentarios.length})
                    
                    each c in post.comentarios
                      .card(style='margin-bottom: 0.75rem; border: 1px solid var(--light-gray);')
                        .card-body(style='padding: 1rem;')
                          p.mb-2
                            strong= (c.autor && c.autor.nome) || 'Utilizador'
                            br
                            small.text-muted= c.conteudo
                
                if user
                  form.mt-3(method='POST', action='/posts/' + post._id + '/comentarios')
                    input(type='hidden', name='recurso', value=recurso._id)
                    .form-group
                      textarea.form-control(name='conteudo', placeholder='Deixe seu comentário...', required=true, rows='4', style='width: 100%; min-height: 120px; resize: vertical;')
                    .row
                      .col-12(style='text-align: right;')
                        button.btn.btn-primary.btn-block(type='submit')
                          i.fas.fa-reply
                          span Comentar
                
                if user && (user.role === 'admin' || user.sub === post.autor._id)
                  form.mt-3(method='POST', action='/posts/' + post._id + '/apagar', onsubmit='return confirm("Tem a certeza?");')
                    input(type='hidden', name='recurso', value=recurso._id)
                    button.btn.btn-sm.btn-danger(type='submit')
                      i.fas.fa-trash-alt
                      | Apagar Post
          else
            .card-body
              .empty-state(style='padding: 2rem 0;')
                i.fas.fa-comments.empty-icon
                p Ainda não há discussões neste recurso. Seja o primeiro a comentar!
