extends ../layout

block content
  .container.py-6
    .row.mb-6
      .col-8
        h1
          i.fas.fa-shield-halved(style='margin-right: 0.75rem; color: var(--primary);')
          span Administração
        p Escolhe a área que queres gerir.
      .col-4
        a.btn.btn-outline.btn-block(href='/recursos')
          i.fas.fa-arrow-left
          span Voltar aos Recursos

    .row
      .col-6
        .card.resource-card
          .card-body
            h3.resource-title Gestão de Tipos
            p.resource-subtitle Configurar os tipos de recurso disponíveis nos formulários.
            .resource-meta
              span
                i.fas.fa-tags
                |  Tipos de recurso
          .card-footer
            a.btn.btn-primary.btn-block(href='/recursos/tipos')
              i.fas.fa-arrow-right
              span Abrir Gestão de Tipos

      .col-6
        .card.resource-card
          .card-body
            h3.resource-title Gestão de AIPs
            p.resource-subtitle Consultar as ingestões e abrir o detalhe de cada AIP.
            .resource-meta
              span
                i.fas.fa-archive
                |  Ingestões
          .card-footer
            a.btn.btn-primary.btn-block(href='/recursos/ingestao')
              i.fas.fa-arrow-right
              span Abrir Gestão de AIPs
