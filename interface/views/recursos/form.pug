extends ../layout

block content
  - const isEdit = !!recurso
  .container.container-lg.py-6
    .row
      .col-12
        .card
          .card-header
            h2
              i(class=isEdit ? 'fas fa-edit' : 'fas fa-plus')
              span(style='margin-left: 0.75rem;')= titulo
          
          .card-body
            if erro
              .alert.alert-danger
                i.fas.fa-exclamation-circle(style='margin-right: 0.5rem;')
                strong= erro
            
            // Formulario de criar/editar
            form(method='POST', action=isEdit ? ('/recursos/' + recurso._id + '/editar') : '/recursos/novo')
              .row
                .col-12
                  .form-group
                    label(for='titulo')
                      i.fas.fa-bookmark(style='margin-right: 0.5rem;')
                      span Título
                    input#titulo.form-control(type='text', name='titulo', placeholder='Título do recurso...', value=isEdit ? recurso.titulo : '', required=true)
                
                .col-12
                  .form-group
                    label(for='subtitulo')
                      i.fas.fa-align-left(style='margin-right: 0.5rem;')
                      span Subtítulo (opcional)
                    input#subtitulo.form-control(type='text', name='subtitulo', placeholder='Descrição breve...', value=isEdit ? (recurso.subtitulo || '') : '')
                
                .col-6
                  .form-group
                    label(for='tipo')
                      i.fas.fa-tag(style='margin-right: 0.5rem;')
                      span Tipo de Recurso
                    select#tipo.form-control(name='tipo', required=true)
                      option(value='') Selecione um tipo
                      each tipo in tiposRecurso
                        option(value=tipo.slug selected=((isEdit ? recurso.tipo : '') === tipo.slug))= tipo.nome
                    small.text-muted(style='display: block; margin-top: 0.5rem;')
                      | Os tipos sao geridos pelos administradores.
                      if user && user.role === 'admin'
                        | 
                        a(href='/recursos/tipos') Gerir tipos
                
                .col-6
                  .form-group
                    label(for='dataCriacao')
                      i.fas.fa-calendar-alt(style='margin-right: 0.5rem;')
                      span Data de Criação
                    input#dataCriacao.form-control(type='date', name='dataCriacao', value=isEdit && recurso.dataCriacao ? new Date(recurso.dataCriacao).toISOString().slice(0,10) : '')
                
                .col-12
                  .form-group
                    label(for='visibilidade')
                      i.fas.fa-eye(style='margin-right: 0.5rem;')
                      span Visibilidade
                    select#visibilidade.form-control(name='visibilidade')
                      option(value='publico' selected=(isEdit ? recurso.visibilidade === 'publico' : true))
                        i.fas.fa-globe(style='margin-right: 0.25rem;')
                        | Público
                      option(value='privado' selected=(isEdit && recurso.visibilidade === 'privado'))
                        i.fas.fa-lock(style='margin-right: 0.25rem;')
                        | Privado
                
                .col-12
                  .form-group
                    label(for='hashtags')
                      i.fas.fa-hashtag(style='margin-right: 0.5rem;')
                      span Hashtags
                    input#hashtags.form-control(type='text', name='hashtags', placeholder='web, programacao, ensino', value=isEdit && recurso.hashtags ? recurso.hashtags.join(', ') : '')
                    small.text-muted(style='display: block; margin-top: 0.5rem;')
                      i.fas.fa-info-circle(style='margin-right: 0.25rem;')
                      | Pode separar varias hashtags por virgulas.

              .card-footer
                button.btn.btn-primary(type='submit')
                  i(class=isEdit ? 'fas fa-save' : 'fas fa-check')
                  span= isEdit ? 'Guardar Alteracoes' : 'Criar Recurso'
                a.btn.btn-outline(href='/recursos')
                  i.fas.fa-arrow-left
                  span Cancelar
