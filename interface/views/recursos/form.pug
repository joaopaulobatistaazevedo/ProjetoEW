extends ../layout

block content
  .container.container-lg.py-6
    .row
      .col-12
        .card
          .card-header
            h2
              i.fas.fa-file-archive(style='margin-right: 0.5rem;')
              span Submeter Recurso (SIP)
          
          .card-body
            if erro
              .alert.alert-danger
                i.fas.fa-exclamation-circle(style='margin-right: 0.5rem;')
                strong= erro
                if erros && erros.length > 0
                  ul(style='margin-top: 0.5rem; margin-bottom: 0;')
                    each err in erros
                      li= err
            
            // Guia de SIP
            .alert.alert-info(style='background-color: #f0f9ff; border-color: #0ea5e9; color: #0c4a6e;')
              i.fas.fa-lightbulb(style='margin-right: 0.5rem;')
              strong Guia de Submissão de SIP:
              p(style='margin-top: 0.5rem; margin-bottom: 0;')
                strong Estrutura do ZIP:
              ul(style='margin-top: 0.25rem; margin-bottom: 0.5rem;')
                li 
                  code manifest.json 
                  | na raiz (obrigatório)
                li 
                  code data/
                  | pasta com ficheiros (obrigatório, pelo menos vazio)
              p(style='margin-bottom: 0.5rem;')
                strong manifest.json deve ter:
              ul(style='margin-top: 0.25rem;')
                li 
                  strong(style='color: #dc2626;') titulo
                  | - texto obrigatório
                li 
                  strong(style='color: #dc2626;') tipo
                  | - um de: artigo, tese, slides, teste, relatorio, aplicacao, problema, outro
                li 
                  strong descricao
                  | - texto descritivo
                li 
                  strong files
                  | - array com nomes dos ficheiros em data/; o campo size é opcional
                li 
                  code dataCriacao
                  | - data em ISO 8601 (2026-05-10)
                li 
                  code visibilidade
                  | - publico ou privado
                li 
                  code hashtags
                  | - array de tags
                li 
                  code subtitulo
                  | - opcional
              
              pre(style='background: #fff; padding: 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; max-height: 200px; overflow-y: auto; color: #000; border: 1px solid #ddd;')
                code.
                  {
                    "titulo": "Meu Artigo",
                    "tipo": "artigo",
                    "descricao": "Descrição do trabalho",
                    "dataCriacao": "2026-05-10",
                    "visibilidade": "publico",
                    "hashtags": ["web", "engenharia"],
                    "files": [
                        {"name": "artigo.pdf"}
                    ]
                  }
            
            // Formulario simples - apenas upload
            form(method='POST', action='/recursos/form', enctype='multipart/form-data')
              .form-group
                label(for='ficheiro')
                  i.fas.fa-file-archive(style='margin-right: 0.5rem;')
                  span Arquivo SIP (ZIP)
                input#ficheiro.form-control(type='file', name='ficheiro', accept='.zip', style='padding: 0.5rem;', required=true)
                small.text-muted(style='display: block; margin-top: 0.5rem;')
                  i.fas.fa-info-circle(style='margin-right: 0.25rem;')
                  | Deve ser um arquivo ZIP estruturado com manifest.json e pasta data/
              
              .card-footer
                button.btn.btn-primary(type='submit')
                  i.fas.fa-upload
                  span Submeter
                a.btn.btn-outline(href='/recursos/novo')
                  i.fas.fa-arrow-left
                  span Voltar
