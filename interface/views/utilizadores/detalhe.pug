extends ../layout

block content
  .container.py-6
    // Breadcrumb
    .mb-4
      a(href='/utilizadores', style='color: var(--gray);')
        i.fas.fa-arrow-left(style='margin-right: 0.25rem;')
        span Voltar a Utilizadores

    if utilizador
      - const isAdmin = user && user.role === 'admin'
      - const isSelf = user && user.sub === utilizador._id
      .row
        .col-4
          // Perfil
          .card
            .card-body.text-center
              i.fas.fa-user-circle(style='font-size: 4rem; color: var(--primary); margin-bottom: 1rem;')
              h2= utilizador.nome
              p.text-muted
                i.fas.fa-at(style='margin-right: 0.5rem;')
                | #{utilizador.username}
              
              .role-badge.mt-4
                - let badgeStyle = utilizador.role === 'admin' ? 'background-color: #e0e7ff; color: #1e3a8a;' : (utilizador.role === 'produtor' ? 'background-color: #dbeafe; color: #0c4a6e;' : 'background-color: #d1d5db; color: #374151;')
                span.resource-badge(style=badgeStyle)
                  i.fas.fa-certificate(style='margin-right: 0.25rem;')
                  | #{utilizador.role.charAt(0).toUpperCase() + utilizador.role.slice(1)}
        
        .col-8
          // Detalhes do utilizador
          .card.mb-6
            .card-header
              i.fas.fa-user
              span  Informações Pessoais
            
            .card-body
              .info-group.mb-4
                strong
                  i.fas.fa-envelope(style='margin-right: 0.5rem;')
                  | Email
                p= utilizador.email
              
              if utilizador.filiacao
                .info-group.mb-4
                  strong
                    i.fas.fa-building(style='margin-right: 0.5rem;')
                    | Instituição
                  p= utilizador.filiacao
              
              .info-group
                strong
                  i.fas.fa-calendar-alt(style='margin-right: 0.5rem;')
                  | Membro desde
                p= utilizador.dataRegisto ? new Date(utilizador.dataRegisto).toLocaleDateString('pt-PT') : 'N/A'
          
          // Editar utilizador (admin ou o proprio utilizador)
          if isAdmin || isSelf
            .card
              .card-header
                i.fas.fa-edit
                span  Editar Utilizador
              
              form(method='POST', action='/utilizadores/' + utilizador._id + '/editar')
                .card-body
                  .form-group
                    label(for='username')
                      i.fas.fa-at(style='margin-right: 0.5rem;')
                      span Nome de Utilizador
                    input#username.form-control(type='text', name='username', value=utilizador.username, required=true)
                  
                  .form-group
                    label(for='nome')
                      i.fas.fa-id-card(style='margin-right: 0.5rem;')
                      span Nome Completo
                    input#nome.form-control(type='text', name='nome', value=utilizador.nome, required=true)
                  
                  .form-group
                    label(for='email')
                      i.fas.fa-envelope(style='margin-right: 0.5rem;')
                      span Email
                    input#email.form-control(type='email', name='email', value=utilizador.email, required=true)
                  
                  if isAdmin
                    .form-group
                      label(for='role')
                        i.fas.fa-certificate(style='margin-right: 0.5rem;')
                        span Role
                      select#role.form-control(name='role')
                        option(value='admin' selected=utilizador.role === 'admin') Admin
                        option(value='produtor' selected=utilizador.role === 'produtor') Produtor
                        option(value='consumidor' selected=utilizador.role === 'consumidor') Consumidor
                  
                  .form-group
                    label(for='filiacao')
                      i.fas.fa-building(style='margin-right: 0.5rem;')
                      span Instituição (opcional)
                    input#filiacao.form-control(type='text', name='filiacao', value=utilizador.filiacao || '')
                
                .card-footer
                  button.btn.btn-primary(type='submit')
                    i.fas.fa-save
                    span Guardar Alterações
                  if isAdmin
                    form(method='POST', action='/utilizadores/' + utilizador._id + '/apagar', style='display: inline; margin-left: 0.5rem;')
                      button.btn.btn-danger(type='submit', onclick='return confirm("Tem a certeza que deseja eliminar este utilizador?")')
                        i.fas.fa-trash
                        span Eliminar Utilizador
                  a.btn.btn-outline(href='/utilizadores')
                    i.fas.fa-arrow-left
                    span Voltar
          else
            .card
              .card-body
                .alert.alert-warning
                  i.fas.fa-lock(style='margin-right: 0.5rem;')
                  strong Permissões Insuficientes
                  p Apenas administradores ou o proprio utilizador podem editar este perfil.
                
                a.btn.btn-outline(href='/utilizadores')
                  i.fas.fa-arrow-left
                  span Voltar
    else
      .card
        .card-body
          .alert.alert-danger
            i.fas.fa-exclamation-circle(style='margin-right: 0.5rem;')
            strong Utilizador não encontrado.
          a.btn.btn-outline(href='/utilizadores')
            i.fas.fa-arrow-left
            span Voltar