extends ../layout

block content
  .w3-container.w3-padding-24
    h2 Utilizadores
    if utilizadores && utilizadores.length
      .w3-responsive
        table.w3-table-all
          thead
            tr
              th Username
              th Nome
              th Email
              th Role
          tbody
            each u in utilizadores
              tr
                td= u.username
                td= u.nome
                td= u.email
                td= u.role
    else
      p Sem utilizadores para mostrar.
