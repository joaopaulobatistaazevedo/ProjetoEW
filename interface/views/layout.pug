doctype html
html(lang='pt-PT')
  head
    title= titulo + ' | Recursos Educativos'
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description', content='Plataforma de gestão de recursos educativos')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    // Navegação
    nav.navbar
      .navbar-inner
        a.navbar-brand(href='/')
          i.fas.fa-graduation-cap
          span Recursos Educativos
        .navbar-menu
          if user
            a.navbar-item(href='/recursos')
              i.fas.fa-book
              span Recursos
            a.navbar-item(href='/utilizadores')
              i.fas.fa-users
              span Utilizadores
            a.navbar-item(href='/utilizadores/' + user.sub)
              i.fas.fa-user
              span= user.nome
            a.navbar-item.navbar-logout(href='/auth/logout')
              i.fas.fa-sign-out-alt
              span Sair
          else
            a.navbar-item(href='/auth/login')
              i.fas.fa-sign-in-alt
              span Login
            a.navbar-item(href='/auth/registo')
              i.fas.fa-user-plus
              span Registo

    // Conteúdo Principal
    main.main-content
      block content

    // Footer
    footer
      .container
        .footer-text
          p © 2026 Plataforma de Recursos Educativos.
