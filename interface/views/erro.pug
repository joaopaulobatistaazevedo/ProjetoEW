extends layout

block content
  .container.py-8
    .row
      .col-12
        .empty-state(style='padding: 4rem 1.5rem;')
          if status && status === 404
            i.fas.fa-search.empty-icon(style='color: var(--warning); font-size: 4rem;')
            h1.empty-title Página Não Encontrada
            p.empty-text
              | Desculpe, a página que está procurando não existe (Erro 404).
          else if status && status === 500
            i.fas.fa-exclamation-triangle.empty-icon(style='color: var(--danger); font-size: 4rem;')
            h1.empty-title Erro do Servidor
            p.empty-text
              | Desculpe, ocorreu um erro no servidor. Tente novamente mais tarde.
          else
            i.fas.fa-exclamation-circle.empty-icon(style='color: var(--danger); font-size: 4rem;')
            h1.empty-title= titulo || 'Erro'
            p.empty-text= mensagem || 'Ocorreu um erro inesperado.'
          
          .mt-6(style='margin-top: 3rem;')
            a.btn.btn-primary(href='/')
              i.fas.fa-home
              span Voltar à Página Inicial
            a.btn.btn-secondary(href='/' onclick='window.history.back();' style='margin-left: 1rem;')
              i.fas.fa-arrow-left
              span Voltar
