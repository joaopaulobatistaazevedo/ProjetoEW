extends layout

block content
  .container.py-8
    .row
      .col-12
        .empty-state(style='padding: 4rem 1.5rem;')
          if status && status === 404
            i.fas.fa-search.empty-icon(style='color: var(--warning); font-size: 4rem;')
            h1.empty-title= titulo || 'Página Não Encontrada'
            p.empty-text= mensagem || 'Desculpe, a página que está procurando não existe (Erro 404).'
          else if status && status === 500
            i.fas.fa-exclamation-triangle.empty-icon(style='color: var(--danger); font-size: 4rem;')
            h1.empty-title= titulo || 'Erro do Servidor'
            p.empty-text= mensagem || 'Desculpe, ocorreu um erro no servidor. Tente novamente mais tarde.'
          else
            i.fas.fa-exclamation-circle.empty-icon(style='color: var(--danger); font-size: 4rem;')
            h1.empty-title= titulo || 'Erro'
            p.empty-text= mensagem || 'Ocorreu um erro inesperado.'
          
          // Contexto adicional (ex: detalhes de erro ou informação)
          if detalhe
            .mt-4(style='margin-top: 1.5rem; padding: 1rem; background: #f8f8f8; border-radius: 0.5rem; border-left: 3px solid var(--warning);')
              small.text-muted= detalhe
          
          // Acoes personalizadas ou default
          .mt-6(style='margin-top: 3rem;')
            if linkVoltar
              a.btn.btn-primary(href=linkVoltar)
                i.fas.fa-undo(style='margin-right: 0.5rem;')
                span= botaoVolta || 'Voltar'
            else
              a.btn.btn-primary(href='/')
                i.fas.fa-home(style='margin-right: 0.5rem;')
                span Voltar à Página Inicial
            
            if !linkVoltar
              a.btn.btn-secondary(onclick='window.history.back();' style='margin-left: 1rem; cursor: pointer;')
                i.fas.fa-arrow-left(style='margin-right: 0.5rem;')
                span Voltar
